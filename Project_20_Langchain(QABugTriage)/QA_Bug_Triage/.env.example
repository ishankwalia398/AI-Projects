# Copy these entries into the existing .env; never use VITE_ for secrets.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GROQ_API_KEY=
JIRA_BASE_URL=https://your-team.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
# Required shared access password for live analysis (at least 16 characters).
APP_ACCESS_TOKEN=
# Optional read-only remote MCP tool. Leave URL empty to use Jira REST directly.
JIRA_MCP_URL=
JIRA_MCP_TOKEN=
JIRA_MCP_TOOL=jira_get_issue
JIRA_MCP_ISSUE_ARG=issue_key
# Additional fixed tool arguments, e.g. {"cloudId":"your-cloud-id"}
JIRA_MCP_EXTRA_ARGS={}
# Deployment only; never sent to the deployed application.
VERCEL_TOKEN=
# Optional team slug
VERCEL_SCOPE=
