{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.py": { "maxDuration": 300, "excludeFiles": "{node_modules/**,.venv/**,tests/**,dist/**,src/**,scripts/**,prompt.md,Readme.md}" },
    "api/ticket.py": { "maxDuration": 30, "excludeFiles": "{node_modules/**,.venv/**,tests/**,dist/**,src/**,scripts/**,prompt.md,Readme.md}" }
  },
  "rewrites": [{ "source": "/api/triage", "destination": "/api/index" }],
  "headers": [{ "source": "/(.*)", "headers": [
    { "key": "X-Content-Type-Options", "value": "nosniff" },
    { "key": "Referrer-Policy", "value": "no-referrer" },
    { "key": "X-Frame-Options", "value": "DENY" }
  ] }]
}
