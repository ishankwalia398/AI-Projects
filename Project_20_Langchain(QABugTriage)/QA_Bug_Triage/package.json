  "private": true,
  "type": "module",
  "engines": { "node": "22.x" },
  "scripts": {
    "dev": "concurrently -k \"python -m uvicorn backend.app:app --host 127.0.0.1 --port 3001 --reload\" \"vite --host 127.0.0.1\"",
