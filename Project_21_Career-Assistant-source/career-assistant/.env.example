APP_ENV=development
DATABASE_URL=postgresql+psycopg://career:change-me@localhost:5432/career
FRONTEND_URL=http://127.0.0.1:5173
COOKIE_SECURE=false
INLINE_WORKER=false
SESSION_HOURS=24
STORAGE_DIR=./data/files
# API keys are server-only. ChatGPT subscriptions do not supply API credits.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-5.1
FALLBACK_API_KEY=
FALLBACK_BASE_URL=https://api.openai.com/v1
FALLBACK_MODEL=gpt-4.1
EMBEDDING_MODEL=text-embedding-3-small
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
# Official board identifiers, comma separated. No unverified sponsors assumed.
GREENHOUSE_BOARDS=
LEVER_SITES=
# Optional employer-authorized API keys, JSON mapping board identifiers to keys.
# Most job seekers will not have these. Unsupported forms use the employer site.
GREENHOUSE_SUBMISSION_KEYS={}
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# Production requires a private S3-compatible bucket. Render's filesystem is ephemeral.
S3_BUCKET=
S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
