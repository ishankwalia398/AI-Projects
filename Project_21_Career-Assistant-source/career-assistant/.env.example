APP_ENV=development
DATABASE_URL=sqlite:///./data/career.db
FRONTEND_URL=http://127.0.0.1:5173
COOKIE_SECURE=false
INLINE_WORKER=true
SESSION_HOURS=24
STORAGE_DIR=./data/files

# Gemini API configuration: Flash for generation; Flash-Lite for extraction and fallback
# Set your Google AI Studio API key in LLM_API_KEY (kept server-side)
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-3.8-flash
FALLBACK_MODEL=gemini-3.5-flash-lite

# Job discovery sources (optional; built-in public boards are used when both settings are blank)
# Comma-separated employer board identifiers, not full URLs. Empty results never create sample jobs.
GREENHOUSE_BOARDS=canonical,cloudflare,stripe,datadog
LEVER_SITES=
FALLBACK_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
FALLBACK_API_KEY=
LLM_REASONING_EFFORT=low
LLM_MAX_OUTPUT_TOKENS=12000
EXTRACTION_MAX_OUTPUT_TOKENS=4096
EMBEDDING_MODEL=gemini-embedding-001
LLM_REQUEST_TIMEOUT_SECONDS=30
LLM_FAILURE_COOLDOWN_SECONDS=300

# Use latex after installing Tectonic (or MiKTeX/TeX Live) and Pandoc.
# Local setup on this computer has portable converters under backend/.tools.
DOCUMENT_RENDERER=native

# Independent generation fallback; separate OpenRouter account/credits. Never expose to frontend.
OPEN_ROUTER_API_KEY=
OPEN_ROUTER_MODEL=mistralai/mistral-small-3.2-24b-instruct

# Fallback chain: Gemini models -> OpenRouter models -> Claude. A model that hits its quota or fails
# is skipped until its cooldown ends; if every model is cooling down, requests wait up to LLM_MAX_WAIT_SECONDS.
GEMINI_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-3-flash-preview,gemini-3.1-flash-lite,gemini-flash-lite-latest
# Free OpenRouter models (no-training providers only, since requests contain resume text).
OPEN_ROUTER_MODELS=dots-studio/dots-3-note-preview:free,google/gemma-4-31b-it:free,google/gemma-4-26b-a4b-it:free,openrouter/free
LLM_MAX_WAIT_SECONDS=90

# Last-resort generation fallback (Claude) when Gemini and OpenRouter quotas are exhausted.
# ANTHROPIC_BASE_URL is optional; set it only when calls go through an Anthropic-compatible gateway.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_FALLBACK_MODEL=claude-sub-opus[1m]
